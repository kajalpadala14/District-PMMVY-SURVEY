# Copy this file to `.env` and paste your deployed Google Apps Script Web App URL.

VITE_APP_NAME="Matru Vandana Yojana Survey & Monitoring Dashboard"
VITE_APP_DISTRICT="Dantewada"
VITE_APP_STATE="Chhattisgarh"

# Required for live Google Sheet data.
# Example format:
# VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec"
VITE_GOOGLE_APPS_SCRIPT_URL="PASTE_YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE"
